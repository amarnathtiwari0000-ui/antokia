{
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/tools/percentage-calculator",
      "destination": "/percentage.html"
    },
    {
      "source": "/tools/:tool",
      "destination": "/:tool.html"
    },
    {
      "source": "/tools/:tool",
      "destination": "/tools/:tool/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/about-us",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/terms.html",
      "statusCode": 301
    }
  ]
}
