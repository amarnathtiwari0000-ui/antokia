{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)\\.html",
      "destination": "/tools/$1",
      "permanent": true
    },
    {
      "source": "/blog/(.*)\\.html",
      "destination": "/blog/$1",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ]
}
